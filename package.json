{
  "name": "lodge-gym",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "dependencies": {
    "@simplewebauthn/server": "14.0.3",
    "hono": "4.13.9",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@cloudflare/workers-types": "5.20260927.1",
    "@fontsource/vazirmatn": "5.3.0",
    "@playwright/test": "1.63.0",
    "@preact/preset-vite": "2.10.6",
    "@simplewebauthn/browser": "14.0.0",
    "@vitest/runner": "4.1.11",
    "@vitest/snapshot": "4.1.11",
    "idb": "8.0.3",
    "preact": "10.29.8",
    "typescript": "5.9.3",
    "vite": "8.0.3",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.11",
    "workbox-build": "7.4.1",
    "workbox-core": "7.4.1",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1",
    "workbox-strategies": "7.4.1",
    "workbox-window": "7.4.1",
    "wrangler": "4.142.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node seed/generate.mjs --check && vite build",
    "typecheck": "tsc -p tsconfig.json && tsc -p web/tsconfig.json",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "seed:build": "node seed/generate.mjs",
    "seed:local": "wrangler d1 execute DB --local --file seed/seed.sql",
    "seed:remote": "wrangler d1 execute DB --remote --file seed/seed.sql",
    "test": "vitest run",
    "e2e": "playwright test",
    "icons": "node scripts/icons.mjs",
    "deploy": "npm run build && npm run deploy:ci",
    "deploy:ci": "wrangler d1 migrations apply DB --remote && wrangler d1 execute DB --remote --file seed/seed.sql && wrangler deploy"
  },
  "engines": {
    "node": ">=20"
  }
}
